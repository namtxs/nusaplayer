{
  "name": "nusaplayer",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "24.x"
  },
  "author": "NusaPlayer contributors",
  "keywords": [
    "nusaplayer",
    "video-player"
  ],
  "scripts": {
    "watch": "pnpm --parallel run start",
    "start": "pnpm run watch",
    "dev": "pnpm --filter=!@nusaplayer/docs --parallel run start",
    "dev:exam": "pnpm --filter=@nusaplayer-examples/standalone start",
    "dev:ui": "pnpm --filter=@nusaplayer/ui run start",
    "build:core": "pnpm --filter=@nusaplayer/core run build",
    "build:docs": "pnpm --filter=@nusaplayer/docs run build",
    "build:vercel": "pnpm --filter=@nusaplayer/docs... --filter=!@nusaplayer/docs run build && pnpm run cp:ui && pnpm --filter=@nusaplayer/docs run build",
    "build:plugins": "pnpm --filter=@nusaplayer/plugins run build",
    "build:ui": "pnpm --filter=@nusaplayer/ui run build",
    "build": "pnpm --filter=!@nusaplayer/docs run build && pnpm run cp:ui",
    "build:packs": "pnpm --filter=@nusaplayer/* run build && pnpm run cp:ui",
    "build:cache": "nx run-many --target=build --all --parallel && pnpm run cp:ui",
    "build:affected": "nx affected --target=build",
    "graph": "nx dep-graph",
    "cp:ui": "node -e \"require('fs').copyFileSync('packages/ui/dist/index.ui.js','packages/core/dist/index.ui.js')\"",
    "clear": "rimraf 'packages/*/{dist,tsconfig.tsbuildinfo,node_modules,.rollup.cache}' && rimraf node_modules && rimraf packages/docs/.next packages/docs/out",
    "changeset": "changeset",
    "release": "changeset publish",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "prettier -w ./packages/*/**/*.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-destructuring": "^7.28.0",
    "@babel/plugin-transform-logical-assignment-operators": "^7.27.1",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.27.1",
    "@babel/plugin-transform-object-rest-spread": "^7.28.0",
    "@babel/plugin-transform-parameters": "^7.27.7",
    "@babel/plugin-transform-spread": "^7.27.1",
    "@babel/plugin-transform-template-literals": "^7.27.1",
    "@changesets/cli": "^2.29.5",
    "@rollup/plugin-babel": "^6.0.4",
    "@types/node": "^20.19.6",
    "@vitejs/plugin-react": "^4.6.0",
    "babel-plugin-syntax-trailing-function-commas": "^6.22.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.5.2",
    "nx": "^19.8.14",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.10",
    "terser": "^5.43.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vite": "^6.4.5",
    "vite-plugin-banner": "^0.7.1",
    "vite-plugin-merge-exports": "^0.0.0",
    "vitest": "^1.6.1"
  }
}
